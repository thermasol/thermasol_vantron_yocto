[Unit]
Description=SignaTouch IR Qt5 Application
After=systemd-user-sessions.service
After=multi-user.target
After=psplash-systemd.service

[Service]
Type=simple
# Run as root to access DRM device
User=root
# Environment variables for Qt5 EGLFS
Environment="QT_QPA_PLATFORM=eglfs"
Environment="QT_QPA_EGLFS_INTEGRATION=eglfs_kms"
Environment="QT_QPA_EGLFS_ALWAYS_SET_MODE=1"
Environment="QT_QPA_EGLFS_KMS_CONFIG=/etc/qt5/eglfs_kms.json"
Environment="QT_LOGGING_RULES=qt.qpa.*=true"
Environment="XDG_RUNTIME_DIR=/run/user/0"
# Fix font warnings
Environment="QT_QPA_FONTDIR=/usr/share/fonts"
# Source rotation environment variable (set by ExecStartPre script). This
# app has no SignaSteam.conf-style config file, so set-display-rotation.sh
# falls back to its default (landscape/0 degrees) - fine unless/until this
# app gets its own configurable orientation.
EnvironmentFile=-/etc/qt5/rotation.env
ExecStartPre=/usr/bin/set-display-rotation.sh
# Hand off the display from the boot splash to the app.
ExecStartPre=-/usr/bin/psplash-write "QUIT"
ExecStart=/usr/bin/SignaTouch_IR
Restart=on-failure
RestartSec=5
# Ensure we have access to graphics devices
SupplementaryGroups=video render

[Install]
WantedBy=graphical.target
