[Unit]
Description=Start psplash boot splash screen
DefaultDependencies=no
# tidss is built into the kernel but defers its DRM probe until the display
# pipeline (panel/DSI) is ready - /dev/fb0 doesn't exist for several seconds
# after sysinit.target, where this unit would otherwise start immediately
# and die with "Error opening /dev/fb0" (confirmed on-device). Requires=/
# After=dev-fb0.device was tried first but the device unit never actually
# transitioned to active on this system - the job just timed out with
# "failed with result 'dependency'" (also confirmed on-device). Retrying
# the process instead is more robust: it doesn't depend on udev tagging
# fb0 for systemd device-unit tracking at all.
RequiresMountsFor=/run
ConditionFileIsExecutable=/usr/bin/psplash
StartLimitIntervalSec=0

[Service]
Type=notify
# -n (no console switch): psplash must NOT put the VT into graphics mode,
# because it then restores text mode when it exits. The app quits psplash
# after its first frame (main.cpp, psplash-write QUIT); the KD_TEXT restore
# re-activates fbcon, and the DRM fbdev helper puts fbcon's framebuffer
# back on the CRTC on top of the app's - the panel goes black while the app
# keeps running and drawing into a buffer nobody scans out. Verified on
# the board via /sys/kernel/debug/dri/0/state: plane fb flips from the
# SignaSteam framebuffer to the [fbcon] one at QUIT without -n, stays
# with -n. Qt eglfs does its own KD_GRAPHICS switch, so nothing is lost.
#
# PSPLASH_ARGS comes from /etc/psplash.env, written by set-display-rotation.sh
# (display-rotation recipe): "-a 90" on landscape units so the splash is
# drawn the same way round as the boot logo and the app, empty otherwise.
# The file is absent on a fresh image, which is portrait.
EnvironmentFile=-/etc/psplash.env
ExecStart=/usr/bin/psplash -n $PSPLASH_ARGS
RemainAfterExit=yes
Restart=on-failure
RestartSec=1

[Install]
WantedBy=sysinit.target
