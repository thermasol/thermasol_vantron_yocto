# Fastboot gadget for the USB-booted flasher U-Boot (u-boot-vt-flasher
# recipe). Merged on top of vt_sbc_am62l_dfu_defconfig, Vantron's flasher
# configuration. Its bootcmd fetched a uEnv.txt over DFU and ran the
# commands in it; this build goes straight to fastboot instead - one USB
# re-enumeration fewer per board (measured 3-6 s) - after the same two mmc
# commands the station's uEnv.txt used to carry (boot0 enabled for boot,
# 8-bit boot bus).
#
# Why fastboot and not DFU for the big write: U-Boot's DFU moves data in
# 4 KB control transfers (~6 MB/s on this board, 107 s for the 627 MB
# .wic). Fastboot uses bulk transfers and understands Android sparse
# images, so the zero-filled half of the image is never sent at all.
CONFIG_USB_FUNCTION_FASTBOOT=y
CONFIG_CMD_FASTBOOT=y
CONFIG_FASTBOOT_USB_DEV=0
# Download buffer: the same DRAM window the DFU flasher already uses for
# uEnv.txt (dfu ram 0x82000000 0x10000000). The host splits anything
# larger into max-download-size pieces, so 256 MB is a chunk size, not a
# limit on the image.
CONFIG_FASTBOOT_BUF_ADDR=0x82000000
CONFIG_FASTBOOT_BUF_SIZE=0x10000000
CONFIG_FASTBOOT_FLASH=y
CONFIG_FASTBOOT_FLASH_MMC=y
CONFIG_FASTBOOT_FLASH_MMC_DEV=0
# "fastboot flash mmc0boot0 <image>" writes the eMMC boot0 hardware
# partition from offset 0: tiboot3.bin, tispl.bin and u-boot.img laid out
# at the same offsets the DFU alts used (0x0, 0x80000, 0x280000), as one
# file. "fastboot flash mmc0 <image>" writes the user area from offset 0 -
# the whole .wic (sparse), GPT included, exactly what "emmc raw 0x0 0x0"
# did over DFU.
CONFIG_FASTBOOT_MMC_BOOT_SUPPORT=y
CONFIG_FASTBOOT_MMC_USER_SUPPORT=y
# "fastboot oem partconf:0 1 1 0" / "oem bootbus:..." replace the mmc
# commands the DFU uEnv.txt ran; kept available, the uEnv still runs them.
CONFIG_FASTBOOT_CMD_OEM_PARTCONF=y
CONFIG_FASTBOOT_CMD_OEM_BOOTBUS=y
CONFIG_BOOTDELAY=-2
CONFIG_BOOTCOMMAND="mmc partconf 0 1 1 0; mmc bootbus 0 2 0 0; fastboot usb 0"
# The dfu defconfig turns HS200 off (the production defconfig has it on).
# The eMMC write is the second-largest slice of the flash (247 MB in 6.5 s
# at the legacy high-speed rate); HS200 roughly doubles it.
CONFIG_MMC_HS200_SUPPORT=y
