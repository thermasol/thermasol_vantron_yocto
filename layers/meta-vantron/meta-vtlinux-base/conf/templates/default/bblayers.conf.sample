# POKY_BBLAYERS_CONF_VERSION is increased each time build/conf/bblayers.conf
# changes incompatibly
POKY_BBLAYERS_CONF_VERSION = "2"

BBPATH = "${TOPDIR}"
BBFILES ?= ""
OEROOT := "${@os.path.abspath(os.path.dirname(d.getVar('FILE')) + '/../..')}"

BASELAYERS ?= " \
  ${OEROOT}/layers/poky/meta \
  ${OEROOT}/layers/poky/meta-poky \
  ${OEROOT}/layers/poky/meta-yocto-bsp \
  ${OEROOT}/layers/meta-openembedded/meta-filesystems \
  ${OEROOT}/layers/meta-openembedded/meta-gnome \
  ${OEROOT}/layers/meta-openembedded/meta-initramfs \
  ${OEROOT}/layers/meta-openembedded/meta-multimedia \
  ${OEROOT}/layers/meta-openembedded/meta-networking \
  ${OEROOT}/layers/meta-openembedded/meta-oe \
  ${OEROOT}/layers/meta-openembedded/meta-perl \
  ${OEROOT}/layers/meta-openembedded/meta-python \
  ${OEROOT}/layers/meta-openembedded/meta-webserver \
  ${OEROOT}/layers/meta-openembedded/meta-xfce \
  "

BASELAYERS += "${@'${OEROOT}/layers/meta-swupdate' if os.path.isfile('${OEROOT}/layers/meta-swupdate/conf/layer.conf') else ''}"
BASELAYERS += "${@'${OEROOT}/layers/meta-qt6' if os.path.isfile('${OEROOT}/layers/meta-qt6/conf/layer.conf') else ''}"
PYTHON2LAYER += "${@'${OEROOT}/layers/meta-python2' if os.path.isfile('${OEROOT}/layers/meta-python2/conf/layer.conf') else ''}"

EFIBOOTGUARDLAYER += "${@'${OEROOT}/layers/meta-efibootguard' if os.path.isfile('${OEROOT}/layers/meta-efibootguard/conf/layer.conf') else ''}"

ARMLAYER += " \
    ${@'${OEROOT}/layers/meta-arm/meta-arm' if os.path.isfile('${OEROOT}/layers/meta-arm/meta-arm/conf/layer.conf') else ''} \
    ${@'${OEROOT}/layers/meta-arm/meta-arm-toolchain' if os.path.isfile('${OEROOT}/layers/meta-arm/meta-arm-toolchain/conf/layer.conf') else ''} \
    "

NXPLAYER += " \
    ${@'${OEROOT}/layers/meta-freescale' if os.path.isfile('${OEROOT}/layers/meta-freescale/conf/layer.conf') else ''} \
    ${@'${OEROOT}/layers/meta-nxp' if os.path.isfile('${OEROOT}/layers/meta-nxp/conf/layer.conf') else ''} \
    "


ROCKCHIPLAYER += "${@'${OEROOT}/layers/meta-rockchip' if os.path.isfile('${OEROOT}/layers/meta-rockchip/conf/layer.conf') else ''}"

TILAYER += "${@'${OEROOT}/layers/meta-ti' if os.path.isfile('${OEROOT}/layers/meta-ti/conf/layer.conf') else ''}"
TILAYER += "${@'${OEROOT}/layers/meta-ti/meta-ti-bsp' if os.path.isfile('${OEROOT}/layers/meta-ti/meta-ti-bsp/conf/layer.conf') else ''}"
TILAYER += "${@'${OEROOT}/layers/meta-ti/meta-ti-extras' if os.path.isfile('${OEROOT}/layers/meta-ti/meta-ti-extras/conf/layer.conf') else ''}"
TILAYER += "${@'${OEROOT}/layers/meta-ti/meta-beagle' if os.path.isfile('${OEROOT}/layers/meta-ti/meta-beagle/conf/layer.conf') else ''}"
TILAYER += "${@'${OEROOT}/layers/meta-clang' if os.path.isfile('${OEROOT}/layers/meta-clang/conf/layer.conf') else ''}"
TILAYER += "${@'${OEROOT}/layers/meta-lts-mixins' if os.path.isfile('${OEROOT}/layers/meta-lts-mixins/conf/layer.conf') else ''}"

MTKLAYER += "${@'${OEROOT}/layers/meta-mediatek-bsp' if os.path.isfile('${OEROOT}/layers/meta-mediatek-bsp/conf/layer.conf') else ''}"

INTELLAYER += "${@'${OEROOT}/layers/meta-intel' if os.path.isfile('${OEROOT}/layers/meta-intel/conf/layer.conf') else ''}"

BSPLAYER ?= " \
    ${ARMLAYER} \
    ${NXPLAYER} \
    ${ROCKCHIPLAYER} \
    ${TILAYER} \
    ${MTKLAYER} \
    ${INTELLAYER} \
    "

OSLAYERS += "${@'${OEROOT}/layers/meta-vantron/meta-vtlinux' if os.path.isfile('${OEROOT}/layers/meta-vantron/meta-vtlinux/conf/layer.conf') else ''}"
OSLAYERS += "${@'${OEROOT}/layers/meta-vantron/meta-vtlinux-base' if os.path.isfile('${OEROOT}/layers/meta-vantron/meta-vtlinux-base/conf/layer.conf') else ''}"
OSLAYERS += "${@'${OEROOT}/layers/meta-vantron/meta-recovery' if os.path.isfile('${OEROOT}/layers/meta-vantron/meta-recovery/conf/layer.conf') else ''}"

WAYLANDLAYERS += "${@'${OEROOT}/layers/meta-vantron/meta-vtlinux-wayland' if os.path.isfile('${OEROOT}/layers/meta-vantron/meta-vtlinux-wayland/conf/layer.conf') else ''}"

CUSTOMLAYERS += "${@'${OEROOT}/layers/meta-vantron/meta-custom' if os.path.isfile('${OEROOT}/layers/meta-vantron/meta-custom/conf/layer.conf') else ''}"

BBLAYERS += " \
    ${BASELAYERS} \
    ${PYTHON2LAYER} \
    ${EFIBOOTGUARDLAYER} \
    ${BSPLAYER} \
    ${OSLAYERS} \
    ${WAYLANDLAYERS} \
    ${CUSTOMLAYERS} \
    "
