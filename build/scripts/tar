#!/bin/sh
# Force classic GNU tar archive format (no PAX extended headers) by default.
# GNU tar >= 1.35 (Ubuntu 24.04) emits PAX 'x' extended headers for entries
# with long/deep pathnames (e.g. locale data under /usr/lib/locale/<locale>/),
# and this host's dpkg (used to unpack .deb archives during do_rootfs) can't
# reliably parse some of those PAX header types: "corrupted filesystem
# tarfile in package archive: unsupported PAX tar header type 'x'". --format
# only affects archive creation (-c); it's a no-op for extract/list.
#
# Two rules this wrapper has to respect:
#
# 1. --format=gnu MUST be appended, never prepended. GNU tar only accepts the
#    old-style bundled option form ("tar xpf -", no leading dash) when it is
#    argv[1], and in the new-style form "-xpf <arg>" the f option consumes the
#    argument that follows it -- so an inserted --format=gnu is swallowed
#    either as a file operand or as f's argument. gcc's install-headers-tar
#    rule uses "tar xpf -" verbatim, which prepending broke with:
#      "You must specify one of the '-Acdtrux' ... options"
#    tar permutes options past operands, so a trailing flag is safe for both.
#
# 2. Don't override a format the caller already asked for. In particular
#    --xattrs implies (and requires) the posix/pax format -- oe's
#    license-destdir copy in do_populate_lic uses it -- and a trailing
#    --format=gnu makes tar bail out with
#      "--xattrs can be used only on POSIX archives"
#    Those archives are pipe-to-directory copies, never fed to dpkg, so
#    leaving them as pax is fine.
for arg in "$@"; do
	case "$arg" in
		--format|--format=*|--posix|--xattrs|--xattrs-*|-H|-H*)
			exec /usr/bin/tar "$@" ;;
	esac
done
exec /usr/bin/tar "$@" --format=gnu
